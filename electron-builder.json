{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.ktech.servicemanagement",
  "productName": "K-Connect",
  "publish": {
    "provider": "github",
    "owner": "vigneshms2302",
    "repo": "ktech-service-management",
    "releaseType": "release"
  },
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "K-Connect"
  },
  "portable": {
    "artifactName": "K-Connect-Portable.exe"
  }
}
