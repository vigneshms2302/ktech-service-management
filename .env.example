# =====================================================================
# K-Connect Cloud SaaS — Production Environment Configuration
# Copy this file to .env and configure real values for your environment.
# NEVER commit the .env file containing real secrets to version control.
# =====================================================================

# Server Port & Host
PORT=5000
NODE_ENV=production

# JWT Secret Key (MANDATORY in production, minimum 32 random characters)
# Generate securely using: openssl rand -base64 32
JWT_SECRET=replace_with_strong_random_secret_at_least_32_characters_long

# Passcode & Sensitive Data Vault Symmetric Encryption Key (AES-256-GCM)
# Recommended: dedicated 32-character key (openssl rand -base64 32)
ENCRYPTION_KEY=replace_with_dedicated_aes256_encryption_key_at_least_32_chars

# CORS Allowed Origins (Comma-separated list of web frontend origins)
# Example: https://kconnect.in,https://app.kconnect.in,https://ktech-service-management.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# Database Configuration (Turso LibSQL Cloud — MANDATORY in production)
# Turso gives remote persistent SQLite at the Edge.
# Create free at: https://turso.tech/
# Example URL: libsql://kconnect-prod-vignesh.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Set to 'true' ONLY if you explicitly want to run production on ephemeral local /tmp SQLite
# ALLOW_LOCAL_DB_IN_PROD=false

# Persistent File Storage (Supabase Storage — MANDATORY in production)
# Create free project at: https://supabase.com/ -> Storage -> New bucket "kconnect-files"
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kconnect-files
# Set to 'true' ONLY if running local development/testing without Supabase Storage
# ALLOW_LOCAL_STORAGE_IN_PROD=false

# Initial Super Admin Provisioning (Bootstrapped securely during first startup)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace_with_strong_master_superadmin_password

# Platform Commercial & GPay Configuration
# Can also be updated in real-time from the Super Admin Control Center (/admin)
DEFAULT_UPI_ID=your_real_vpa@okaxis
DEFAULT_PAYEE_NAME=Your Full Business Name or Founder Name
DEFAULT_ANNUAL_PRICE_INR=14999
DEFAULT_TRIAL_DAYS=14
DEFAULT_QR_IMAGE_URL=

# Max Upload Size in Bytes (default: 10485760 = 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Support Contacts
SUPPORT_PHONE=+91 98422 00000
SUPPORT_EMAIL=billing@kconnect.cloud
