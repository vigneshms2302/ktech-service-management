{
  "name": "ktech-service-management",
  "version": "1.2.0",
  "private": true,
  "description": "KTech Computers internal service and business management desktop application",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "dev:saas": "concurrently -n \"API,WEB\" -c \"blue,green\" \"tsx watch server/index.ts\" \"vite\"",
    "build:web": "tsc && vite build",
    "build": "tsc && vite build && electron-builder",
    "build:portable": "tsc && vite build && electron-builder --win portable",
    "build:dir": "tsc && vite build && electron-builder --dir",
    "build:vite": "tsc && vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "db:verify": "tsx scripts/verify-cloud-db.ts",
    "storage:verify": "tsx scripts/verify-storage.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.38.4",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.30.4",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.0.3"
  }
}
